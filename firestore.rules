rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Uygulamanın sahibi: ilk giriş yapan Google hesabı (claimOwner fonksiyonu yazar).
    function isOwner() {
      return request.auth != null
        && get(/databases/$(database)/documents/meta/access).data.owner == request.auth.uid;
    }

    match /meta/access {
      allow read: if request.auth != null;
    }

    match /radar/{docId} {
      allow read: if isOwner();
      // Uygulama yalnızca izleme listesini değiştirebilir; durum ve sinyalleri sunucu yazar.
      allow write: if isOwner() && docId == 'config'
        && request.resource.data.watchlist is list
        && request.resource.data.watchlist.size() <= 60;
    }

    match /devices/{token} {
      allow read, delete: if isOwner() && resource.data.uid == request.auth.uid;
      allow create, update: if isOwner() && request.resource.data.uid == request.auth.uid;
    }
  }
}
